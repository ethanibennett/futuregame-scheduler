<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleExecutable</key>
    <string>DashboardSaver</string>

    <key>CFBundleIdentifier</key>
    <string>me.futurega.DashboardSaver</string>

    <key>CFBundleName</key>
    <string>DashboardSaver</string>

    <key>CFBundleDisplayName</key>
    <string>Daily Dashboard</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- BNDL is the required package type for a .saver bundle -->
    <key>CFBundlePackageType</key>
    <string>BNDL</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Principal class = the name the class has in the OBJECTIVE-C runtime, which is what
         NSBundle looks up. A bare Swift class registers as "Module.Class", but an explicit
         @objc(Name) attribute overrides that entirely, and DashboardSaverView carries
         @objc(DashboardSaverView) - so the runtime name is the unqualified one and the
         module name does not appear. Getting this wrong fails silently in the worst way:
         the bundle links, principalClass comes back nil, the engine has nothing to
         instantiate, and the screen is simply black with nothing logged anywhere.
         Verify after any rename with:
           nm -gU .../Contents/MacOS/DashboardSaver | grep OBJC_CLASS -->
    <key>NSPrincipalClass</key>
    <string>DashboardSaverView</string>

    <!-- Minimum system version: Swift screensavers need a modern runtime. -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <key>NSHumanReadableCopyright</key>
    <string>© 2026 futurega.me</string>
</dict>
</plist>
