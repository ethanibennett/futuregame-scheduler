# Schedule source documents (user uploads, archived per-venue)
# Kept local-only — structure/schedule PDFs are reference copies that the
# extraction pipeline pulls data from into the DB. Production doesn't need
# the raw files, just the extracted columns (starting_chips, level_duration,
# etc.) which get carried across via /api/tournaments/sync.
schedule-docs/

# Build output
public-vite/
vite-app/public/version.txt
build/

# Dev scratch
test-hands.json
test-hands.md
test-hands-compact.md
generate-test-hands.js
.env.save

# macOS
.DS_Store

# CFR solver training checkpoints (full regret state, large)
solver/strategies/*.ckpt.json
solver/strategies/*.ckpt.json.tmp
# training working artifacts — never ship (mid-train snapshots, backups, quarantined ckpts, parked runs)
solver/strategies/*.retrain.json
solver/strategies/*.retrain.meta.json
solver/strategies/*.frozen-*.json
solver/strategies/*.stale-*.json
solver/strategies/*.best-*.json
solver/strategies/_parked-midday-run/
# Supervisor convergence log (local training artifact)
solver/strategies/curve.csv
# Neural-solver datagen shards, trained nets, runtime artifacts (large, local)
solver/neural/data/
solver/neural/nets/
solver/neural/**/*.pt
solver/neural/*.pid
solver/neural/*.log

# Python venv for the neural solver (PyTorch)
solver/neural/.venv/

# solver/ is fetched at build time from futuregame-solver (SOLVER_REPO_TOKEN) or cloned locally
solver/

# local pm2 config (holds local JWT_SECRET)
ecosystem.config.cjs

# Holds a long-lived Claude Code auth token — never commit
ecosystem.remote-control.cjs

# Generated hourly by mtt-emit (mtt-series-watcher) and ingested in-process — never committed.
mtt-feed/

# Retry budget for the TestFlight sleep-kill watchdog (runtime state, this box only)
.testflight-watchdog.json

# Local smoke-test inputs (one holds a guest token)
.smoke-*.txt
