<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>futurega.me β</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- iOS 26+ requires UIScene lifecycle adoption; without this manifest an app
	     built against that SDK crashes at launch (see SceneDelegate in
	     AppDelegate.swift). UISceneStoryboardFile=Main keeps the existing
	     CAPBridgeViewController window; the delegate class lives in the App
	     module. UIMainStoryboardFile above is ignored once a scene is declared. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>instagram</string>
	</array>
	<!-- Facebook App ID for "Add to Instagram Story" sharing. Instagram passes
	     this as source_application and drops the shared sticker without it.
	     Register an app at developers.facebook.com and paste its App ID below;
	     while this is empty, sharing falls back to the iOS share sheet. -->
	<key>FacebookAppID</key>
	<string>2849722905386924</string>
	<!-- WKWebView routes navigator.geolocation through CoreLocation, and CoreLocation refuses to
	     even PROMPT without this key — the web layer just gets a denial, so "Current Location"
	     showed "Could not get your location" with no permission dialog. The PWA never hit this
	     because Safari holds the location entitlement itself; the wrapper declares its own. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>futurega.me uses your location to find tournaments near you</string>
	<key>NSCameraUsageDescription</key>
	<string>futurega.me uses the camera for table scanning and registration photos</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>futurega.me saves table scanner exports and schedule images to your photo library</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>futurega.me saves table scanner exports and schedule images to your photo library</string>
</dict>
</plist>
